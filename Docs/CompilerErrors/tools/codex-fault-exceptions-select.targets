<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="CodexSelectFaults" BeforeTargets="ClCompile">
    <ItemGroup><ClCompile Remove="@(ClCompile)" Condition="'%(ClCompile.Filename)' != 'InvalidInternalOpException' and '%(ClCompile.Filename)' != 'UnsupportedExecutionSurfaceException' and '%(ClCompile.Filename)' != 'InvalidPipelineLaneException'" /></ItemGroup>
  </Target>
</Project>
