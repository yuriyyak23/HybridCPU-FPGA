	void SystemDeviceCommandMicroOp::InitializeMetadata()
	{
		setReadRegisters(UsesTokenRegister(getCommandKind()) && getTokenRegister() != 0 ? {static_cast<int>(getTokenRegister())} : Array::Empty<int>());
		setWriteRegisters(getWritesRegister() ? {static_cast<int>(getDestinationRegister())} : Array::Empty<int>());
		ReadMemoryRanges = Array::Empty<(unsigned long long, unsigned long long)>();
		WriteMemoryRanges = Array::Empty<(unsigned long long, unsigned long long)>();
		setResourceMask(BuildResourceMask(getPlacement().DomainTag, getReadRegisters(), getWriteRegisters()));

		PublishExplicitStructuralSafetyMask();
		RefreshAdmissionMetadata(shared_from_this());
	}

	void SystemDeviceCommandMicroOp::RefreshWriteMetadata()
	{
		InitializeMetadata();
	}

