	ResourceBitset ResourceMaskBuilder::ForRegisterRead(int regId)
	{
		int group = regId / 4;
		if (group >= 16)
		{
			group = 15; // Clamp to 16 groups
		}
		return ResourceBitset(1ULL << (REG_READ_BASE + group), 0);
	}

